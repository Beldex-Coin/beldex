# Local devnet (utils/local-devnet/master_node_network.py). The first devnet
# MN's RPC port is pinned to 19191 by the script. Values must be literals —
# this loader does NOT do shell expansion.
BRIDGE_SIGNER_BELDEXD_RPC_URL=http://127.0.0.1:19191
# beldexd's OxenMQ socket lives in the devnet node's data dir; adjust to the
# testdata dir the script prints on startup.
BRIDGE_SIGNER_OXENMQ_ENDPOINT=ipc:///Users/mac/Niyas/projects/beldex/utils/local-devnet/testdata/beldex-127.0.0.1-19191/devnet/beldexd.sock
# Placeholder gateway id (32-byte hex) until a devnet gateway is registered.
BRIDGE_SIGNER_GATEWAY_ID=1111111111111111111111111111111111111111111111111111111111111111
# Placeholder MN pubkey (32-byte hex); replace with this seat's real MN pubkey.
BRIDGE_SIGNER_SELF_MN_PUBKEY=abababababababababababababababababababababababababababababababab
# Devnet-scaled consensus params (cryptonote_config.h bridge_epoch_blocks /
# bridge_committee_threshold for DEVNET): epoch 120 blocks, t+1 = 4 of n = 6.
BRIDGE_SIGNER_BRIDGE_EPOCH_BLOCKS=120
BRIDGE_SIGNER_COMMITTEE_THRESHOLD=4
